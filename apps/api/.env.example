HOST=127.0.0.1
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only the API key is required. A provider without a key is shown as unavailable.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: narrow the built-in free-tier catalog (comma-separated, no wildcards).
# Empty = every catalog model; the first one is the default. Unknown IDs disable the provider.
# Gemini: gemini-3.5-flash-lite, gemini-3.6-flash, gemini-3.8-flash
# Groq:   openai/gpt-oss-20b, openai/gpt-oss-120b
GEMINI_ALLOWED_MODELS=
GROQ_ALLOWED_MODELS=
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=100
AI_MAX_CONCURRENT=2
AI_TIMEOUT_MS=45000
# Experimental code agent: enabled by default locally; always disabled in production.
# Requests must come from loopback and a localhost/127.0.0.1 Host and Origin.
ADVANCED_AI_ENABLED=true
