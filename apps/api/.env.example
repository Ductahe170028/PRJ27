HOST=127.0.0.1
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only the API key is required. A provider without a key is shown as unavailable.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: narrow the built-in free-tier catalog (comma-separated, no wildcards).
# Empty = every catalog model; the first one is the default. Unknown IDs disable the provider.
# Gemini: gemini-3.5-flash-lite, gemini-3.6-flash, gemini-3.8-flash
# Groq:   openai/gpt-oss-20b, openai/gpt-oss-120b
GEMINI_ALLOWED_MODELS=
GROQ_ALLOWED_MODELS=
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=100
AI_MAX_CONCURRENT=2
AI_TIMEOUT_MS=45000
# Experimental code agent (frozen, not part of the MVP): OFF by default. Set true to enable it
# locally; it is always disabled in production.
# Requests must come from loopback and a localhost/127.0.0.1 Host and Origin.
ADVANCED_AI_ENABLED=false

# --- Reverse proxy -----------------------------------------------------------
# Whose X-Forwarded-For Express believes. Only "loopback" (the Nginx on this
# machine) or "off". Unset: loopback when NODE_ENV=production, otherwise off.
# Never "true" or a hop count: any other peer could then choose its own address.
# TRUST_PROXY=loopback

# --- Advanced job queue (in memory, lost on restart) -------------------------
# Defaults suit a 2 vCPU / 2 GB host: one game at a time, a short line.
# GAME_JOB_TIMEOUT_MS + GAME_JOB_MAX_WAIT_MS must not exceed 300000.
GAME_JOB_CONCURRENCY=1
GAME_JOB_MAX_QUEUE=2
GAME_JOB_TIMEOUT_MS=240000
GAME_JOB_MAX_WAIT_MS=60000
GAME_JOB_MAX_PER_IP=2

# --- Advanced sandbox (Docker) -----------------------------------------------
# docker (default) runs the Playwright check in a locked-down container.
# local runs Chromium on this machine: development only, refused in production.
ADVANCED_TESTER=docker
# Build with `npm run sandbox:build`. Always a pinned tag or digest, never :latest.
SANDBOX_IMAGE=gamecreator-sandbox:pw1.60.0
SANDBOX_CONCURRENCY=1
SANDBOX_MEMORY_MB=768
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_TMP_MB=64
SANDBOX_SHM_MB=128
SANDBOX_TIMEOUT_MS=45000
# How often the container isolation self-check is repeated.
SANDBOX_RECHECK_MS=300000
