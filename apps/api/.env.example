HOST=127.0.0.1
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only enable IDs you have verified in YOUR free-tier account.
# Supported Gemini IDs: gemini-2.5-flash-lite, gemini-2.5-flash
# Supported Groq IDs: openai/gpt-oss-20b, llama-3.3-70b-versatile
# Comma-separated allowlists; empty means disabled. No automatic fallback.
GEMINI_API_KEY=
GEMINI_ALLOWED_MODELS=
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_ALLOWED_MODELS=
GROQ_FREE_TIER_CONFIRMED=false
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=100
AI_MAX_CONCURRENT=2
AI_TIMEOUT_MS=45000
