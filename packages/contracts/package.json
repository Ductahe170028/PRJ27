{
  "name": "@mindx-360/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API contracts for the MindX 360 frontend and backend",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && npm run build && node --test test/package-exports.test.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
