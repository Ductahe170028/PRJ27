# Copy to .env at project root. All values stay on the backend.
API_MODE=mock
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
UPSTREAM_TIMEOUT_MS=10000

# Real API: fill these only after endpoints and auth format are verified.
LMS_GRAPHQL_URL=
DENISE_GRAPHQL_URL=
LMS_AUTH_HEADER=Authorization
LMS_AUTH_VALUE=
DENISE_AUTH_HEADER=Authorization
DENISE_AUTH_VALUE=

# Personal real-API reads through http://127.0.0.1:5173, without a Tech gateway.
# Allowed ONLY with HOST=127.0.0.1 and APP_ENV=development. Mutation gates remain unchanged.
LOCAL_PERSONAL_MODE=false

# Company gateway option when LOCAL_PERSONAL_MODE=false.
# Gateway must strip incoming identity headers and inject verified identity/roles.
TRUSTED_PROXY_AUTH=false
TECH_ID_HEADER=x-tech-id
TECH_ROLES_HEADER=x-tech-roles
TECH_REQUIRED_ROLE=homework-support

# Real writes require enable flag, exact approval, test/staging and trusted gateway auth.
# LOCAL_PERSONAL_MODE stays read-only because it requires development.
# Use only approved test records. Do not use production URLs.
REAL_MUTATIONS_ENABLED=false
REAL_WRITE_APPROVAL=
APP_ENV=development
# Optional write allowlists: empty = unrestricted by that list; populated = only listed IDs.
# LMS list uses Student.id (not studentId code); course list uses Denise courseId.
# Empty lists do NOT bypass auth, environment, approval or REAL_MUTATIONS_ENABLED gates.
APPROVED_TEST_LMS_IDS=
APPROVED_TEST_COURSE_IDS=
